# --- Site --------------------------------------------------------------
# Public-facing site URL (used for canonical links, OG, sitemap).
NEXT_PUBLIC_SITE_URL=https://bizautofy.com

# --- Contact form: Resend ---------------------------------------------
# Create a Resend account (https://resend.com), verify the bizautofy.com
# domain, and create an API key. Without these, the contact form will
# return a friendly fallback message and skip sending.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Bizautofy <hello@bizautofy.com>
CONTACT_TO_EMAIL=hello@bizautofy.com

# --- Rate limiting: Upstash Redis -------------------------------------
# Create a free Upstash Redis database and copy the REST URL + token.
# Without these, the form falls back to a single-instance in-memory
# limiter (safe for local dev, NOT safe in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
